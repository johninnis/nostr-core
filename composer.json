{
    "name": "innis/nostr-core",
    "description": "Core domain entities and services for Nostr protocol implementation",
    "type": "library",
    "license": "MIT",
    "keywords": ["nostr", "protocol", "core", "domain"],
    "authors": [
        {
            "name": "John Innis",
            "email": "john@innis.xyz",
            "homepage": "https://www.innis.xyz/"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-ctype": "*",
        "ext-filter": "*",
        "ext-gmp": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-sodium": "*",
        "paragonie/ecc": "^2.6",
        "paragonie/sodium_compat": "^2.5.2"
    },
    "suggest": {
        "ext-ffi": "The native libsecp256k1 that Secp256k1Signer::create() and Secp256k1Ecdh::create() require, and NIP-49 scrypt"
    },
    "require-dev": {
        "ext-ffi": "*",
        "friendsofphp/php-cs-fixer": "^3.95.29",
        "innis/coding-standards": "^0.2.4",
        "phpstan/phpstan": "~2.3.5",
        "phpstan/phpstan-phpunit": "^2.1.1",
        "phpunit/phpunit": "^13.4.6",
        "rector/rector": "~2.8.4"
    },
    "autoload": {
        "psr-4": {
            "Innis\\Nostr\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Innis\\Nostr\\Core\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "phpunit",
            "@analyse"
        ],
        "test-unit": "phpunit --testsuite=Unit",
        "test-compliance": "phpunit --testsuite=Compliance",
        "test-no-ffi": "phpunit --exclude-group ffi",
        "test-coverage": "XDEBUG_MODE=coverage phpunit --coverage-html var/tests/coverage/html --coverage-text --coverage-clover var/tests/coverage/clover.xml",
        "analyse": "phpstan analyse",
        "fix-style": "php-cs-fixer fix",
        "check-style": "php-cs-fixer fix --dry-run --diff",
        "rector": "rector process",
        "check-rector": "rector process --dry-run",
        "examples": "for example in examples/*.php; do echo \"== $example\"; php \"$example\" || exit 1; done",
        "check-path-lengths": "check-path-lengths"
    },
    "config": {
        "sort-packages": true
    }
}
